# Backend origin used by the Next.js rewrite proxy.
# Local:  http://127.0.0.1:8000
# Docker: http://backend:8000
# Cloud:  https://<your-backend-host>
API_URL=http://127.0.0.1:8000

# HMAC secret for short-lived AI tickets. Falls back to VERCEL_PROJECT_ID.
# AI_GUARD_SECRET=

# Kill switches — set to 1 to disable that AI path without a redeploy.
# AI_HYBRID_DISABLED=1
# AI_VISION_DISABLED=1
