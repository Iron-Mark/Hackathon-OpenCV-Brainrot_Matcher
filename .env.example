# Backend origin used by the Next.js rewrite proxy.
# Local:  http://127.0.0.1:8000
# Docker: http://backend:8000
# Cloud:  https://<your-backend-host>
API_URL=http://127.0.0.1:8000

# Required by the optional Python image-processing backend. Generate at least
# 32 random characters and send it as `Authorization: Bearer <token>`.
# BACKEND_API_TOKEN=
# Comma-separated browser origins; wildcard CORS is rejected.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required HMAC secret for short-lived, client-bound AI tickets. Use at least
# 32 random characters. Paid AI routes fail closed when this is missing.
# AI_GUARD_SECRET=

# Kill switches — set to 1 to disable that AI path without a redeploy.
# AI_HYBRID_DISABLED=1
# AI_VISION_DISABLED=1
